{
  "$defs": {
    "Character": {
      "additionalProperties": true,
      "properties": {
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "temporary_name": {
          "default": true,
          "title": "Temporary Name",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "visual_signatures": {
          "items": {
            "type": "string"
          },
          "title": "Visual Signatures",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/CharacterRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/TimeSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "character_id",
        "display_name"
      ],
      "title": "Character",
      "type": "object"
    },
    "CharacterRelationship": {
      "additionalProperties": true,
      "properties": {
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/TimeSpan"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "target_id",
        "relation"
      ],
      "title": "CharacterRelationship",
      "type": "object"
    },
    "TimeSpan": {
      "additionalProperties": true,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "start",
        "end"
      ],
      "title": "TimeSpan",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/Character"
      },
      "title": "Characters",
      "type": "array"
    },
    "unresolved_conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Conflicts",
      "type": "array"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "characters"
  ],
  "title": "CharacterRegistry",
  "type": "object"
}